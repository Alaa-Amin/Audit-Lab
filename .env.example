# Copy this file to .env for local testing, or set these as Environment
# Variables in your Vercel project settings (Settings > Environment Variables).
# Never commit a real .env file with real keys to GitHub.

# Get this free from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - defaults to gemini-2.5-flash if not set.
GEMINI_MODEL=gemini-2.5-flash

# Get these from your Supabase project: Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
